{
  "name": "irvis",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "docs-check": "node tools/docs-check/src/check-docs.ts",
    "decisions-index": "node tools/docs-check/src/decisions-index.ts",
    "capture": "node tools/capture-cli/src/cli.ts",
    "spike:m2": "node tools/capture-cli/src/cli.ts usb",
    "spike:m1": "node tools/capture-cli/src/cli.ts spike",
    "bench:irvis": "node packages/core/test/benchmark/irvis.ts",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spike:m3:web": "npm run dev --workspace @irvis/web -- --host localhost",
    "spike:m3:desktop": "npm run build && npm run start --workspace @irvis/desktop",
    "test:desktop": "npm run build && npm run test:smoke --workspace @irvis/desktop",
    "ffmpeg:build": "bash apps/desktop/ffmpeg/build.sh",
    "ffmpeg:verify": "node apps/desktop/ffmpeg/verify.mjs",
    "package:desktop": "npm run build && npm run package --workspace @irvis/desktop --",
    "test:parity": "vitest run --config packages/ui/test/parity/vitest.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
